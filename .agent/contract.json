{
  "schema_version": 1,
  "project": "amp-moodle",
  "purpose": "Host-oriented LAMP/LEMP Moodle installer with container and VM validation.",
  "actions": [
    {
      "id": "verify",
      "intent": "Execute the complete configured local gate before publishing this repository.",
      "argv": [
        "lefthook",
        "run",
        "pre-push",
        "--force"
      ],
      "effects": [
        "read",
        "local_write",
        "process",
        "network"
      ],
      "acceptance_scope": "fixture",
      "inputs": [
        "lefthook.yml",
        "Makefile",
        "package.json",
        "pyproject.toml",
        "uv.lock",
        "tests/security/test_installer_secrecy.py",
        "laemp.sh",
        ".npmrc",
        "scripts/hooks/check-staged-shell.sh",
        "scripts/hooks/check-staged-yaml.sh",
        "scripts/hooks/lib.sh",
        "scripts/hooks/run-local-ci.sh",
        "tests/README.md",
        "tests/docker/compose-up.sh",
        "tests/docker/frankenphp/Dockerfile",
        "tests/docker/lib.sh",
        "tests/docker/run-baseline.sh",
        "tests/docker/run-frankenphp-spike.sh",
        "tests/docker/run-matrix.sh",
        "tests/docker/tls-preflight.sh",
        "tests/e2e/moodle.spec.ts",
        "tests/e2e/slicer-smoke.spec.ts",
        "tests/security/test_installer_backend_flow.py",
        "tests/security/test_installer_storage.py",
        "tests/slicer/lib.sh",
        "tests/slicer/run-matrix.sh",
        "tests/slicer/run-test.sh",
        "tests/slicer/test-laemp.sh",
        "verify-moodle.sh",
        "tests/local-gate-refusal.bats"
      ],
      "requires": [],
      "recovery": "Read the failed owner job; repair its source or declared prerequisite, then rerun the full local gate. Fixture acceptance does not authorize cloud/device deployment."
    },
    {
      "id": "verify-lesson",
      "intent": "Re-evaluate the retained domain decision using its owning regression/contract.",
      "argv": [
        "uv",
        "run",
        "--locked",
        "make",
        "test-security"
      ],
      "effects": [
        "read",
        "local_write",
        "process",
        "network"
      ],
      "acceptance_scope": "fixture",
      "inputs": [
        "tests/security/test_installer_secrecy.py",
        "laemp.sh",
        "Makefile",
        "package.json",
        "pyproject.toml",
        "uv.lock",
        "lefthook.yml",
        ".npmrc"
      ],
      "requires": [],
      "recovery": "Inspect the named source/test and reproduce the failing synthetic case before reusing this lesson."
    }
  ],
  "learning": [
    {
      "id": "owner-invariant",
      "when": [
        "credentials",
        "privacy",
        "installer"
      ],
      "summary": "Installer credential acceptance uses synthetic secrets and must preserve argv/log/file privacy; an option-parsing pass does not prove a live Moodle install.",
      "owner": "tests/security/test_installer_secrecy.py",
      "basis": [
        {
          "path": "tests/security/test_installer_secrecy.py",
          "sha256": "b90d729e29bddb16820b8375f3a769f369f2792c2a64f2604e3dec73f793820e"
        },
        {
          "path": "laemp.sh",
          "sha256": "569c056b8200e25eaf4feac0a755f8525e6bcde8e5e3deb406bcf338eb11ac59"
        }
      ],
      "verify_action": "verify-lesson"
    },
    {
      "id": "full-gate-refusal",
      "when": [
        "gate",
        "skip",
        "recursive",
        "verification"
      ],
      "summary": "Skipped or recursive full-gate execution is not acceptance. Execute mode refuses those conditions before effects; preview remains read-only. The required fixture job proves both refusals and the preview control.",
      "owner": "scripts/hooks/run-local-ci.sh",
      "basis": [
        {
          "path": "scripts/hooks/run-local-ci.sh",
          "sha256": "e25d22b7de85f806969b5f7ac785c13297784d08a2ea223510b172a55b8e3b0d"
        },
        {
          "path": "tests/local-gate-refusal.bats",
          "sha256": "adb2c1d99d7f7aa5811684634c64f24515bb03a7e01c296b1ab01abf9992d905"
        }
      ],
      "verify_action": "verify"
    }
  ]
}
